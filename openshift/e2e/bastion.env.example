# Bastion / containerlab env — optional reference template (not required to source).
#
# Prefer supplying settings from the shell, a local wrapper, or CI. Minimal make:
#   make e2e-bastion \
#     OPENPE_KUBECONFIG=/path/to/ocp/kubeconfig \
#     OPENPE_UNDERLAY_IFACE=ens1f0.173 \
#     OPENPE_UNDERLAY_IFACE2=ens1f1.174
#
# Required for make e2e-bastion:
#   OPENPE_KUBECONFIG
#   OPENPE_UNDERLAY_IFACE / OPENPE_UNDERLAY_IFACE2  (real worker NICs, e.g. ens1f0.173)
# Direct ./openshift/e2e/e2e-bastion.sh uses KUBECONFIG instead of OPENPE_KUBECONFIG.
#
# Prerequisites (already installed and Ready):
#   OpenPERouter in openshift-openperouter
#   FRR-K8s in openshift-frr-k8s (CNO additionalRoutingCapabilities)
#
# Layout sketch:
#   leaf VLAN A → bastion eth1 → toswitch1 → leafkind1
#   leaf VLAN B → bastion eth2 → toswitch2 → leafkind2
#   eth0 = mgmt / SSH / default route only
#
# Optional: copy/edit and `set -a && source ./my-bastion.env && set +a`

CLAB_EXECUTOR=local
CLAB_BASTION_MGMT_IFACE=eth0

# Optional remote-bastion vars (unused when CLAB_EXECUTOR=local).
# CLAB_BASTION_HOST=bastion.example.invalid
# CLAB_BASTION_USER=cloud-user
# CLAB_BASTION_SSH=cloud-user@bastion.example.invalid
# CLAB_BASTION_WORKDIR=/home/cloud-user/openperouter

# Docker by default. On registry/Podman bastions override:
#   CLAB_RUNTIME=podman
#   OPENPE_CLAB_RUNTIME=podman
#   CONTAINER_RUNTIME=/absolute/path/to/openperouter/openshift/e2e/podman-root.sh
CLAB_RUNTIME=docker
OPENPE_CLAB_RUNTIME=${CLAB_RUNTIME}
# CONTAINER_RUNTIME=docker

CLAB_BASTION_LAB_IFACE_TOSWITCH1=eth1
CLAB_BASTION_LAB_IFACE_TOSWITCH2=eth2
CLAB_BASTION_ATTACH_LAB_IFACE=true
CLAB_BASTION_LAB_IFACE=eth1

OPENPE_BASTION_LAB_IFACE=${CLAB_BASTION_LAB_IFACE}
OPENPE_BASTION_ATTACH_LAB_IFACE=${CLAB_BASTION_ATTACH_LAB_IFACE}
# Skip leafSRV6/hostSRV6_* setups (default true on bastion).
OPENPE_BASTION_SKIP_SRV6_SETUP=true

# Cluster kubeconfig (required).
# make e2e-bastion needs OPENPE_KUBECONFIG; direct e2e-bastion.sh needs KUBECONFIG.
# KUBECONFIG=/path/to/ocp/kubeconfig
# OPENPE_KUBECONFIG=${KUBECONFIG}

# Nodes for nodelink generation and Ginkgo --instrumented-nodes-label.
# Default worker includes master/control-plane nodes that also have the worker
# label. Prefer a CNF-only role when masters must be excluded, e.g.:
# OPENPE_E2E_NODE_SELECTOR=node-role.kubernetes.io/workercnf
OPENPE_E2E_NODE_SELECTOR=node-role.kubernetes.io/worker
# Script default is 100; this template illustrates a lab-specific base of 103.
OPENPE_BASTION_NODE_IP_BASE=103

# Optional focus/skip for run_tests-bastion.sh. Unset = full suite (+ built-in excludes).
# OPENPE_E2E_FOCUS='Single.Session.Baseline|Node.Router.Status'
# OPENPE_E2E_SKIP='Webhook|DHCP|SRV6'
# OPENPE_E2E_NAMESPACE=openshift-openperouter

# FRR-K8s is a prerequisite (CI/lab provisions CNO FRR). deploy-bastion waits
# for Ready pods in FRRK8S_NAMESPACE; it does not enable or tear down FRR.
# FRRK8S_NAMESPACE=openshift-frr-k8s

# Worker underlay IPs (configure before Ginkgo; remove on EXIT).
OPENPE_E2E_TEARDOWN_WORKER_NET=true
OPENPE_UNDERLAY_IFACE=eth1.100
OPENPE_UNDERLAY_IFACE2=eth2.200

# Skip all EXIT cleanup (worker-net + clab).
# OPENPE_E2E_SKIP_TEARDOWN=true
